{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-x64-release",
      "displayName": "Windows x64 Release (MSVC + vcpkg)",
      "description": "Native Windows developer build using MSVC, Ninja, and the repository vcpkg manifest.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-x64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": {
          "type": "FILEPATH",
          "value": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
        },
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-x64-release",
      "configurePreset": "windows-msvc-x64-release",
      "configuration": "Release",
      "jobs": 0
    }
  ]
}
